# Backend API
SERVER_PORT=5000
SESSION_SECRET=your-session-secret-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production

# Database (SQLite - automatic, stored in data/ folder)
# No configuration needed - uses SQLite locally

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google Agenda (page Calendrier) — OAuth (optionnel)
# Crée des identifiants "OAuth 2.0 Client ID" (type Web) dans Google Cloud Console,
# active l'API Google Calendar, et déclare l'URI de redirection autorisée :
#   http://localhost:3000/api/google-calendar/callback   (local)
#   https://<ton-domaine-vercel>/api/google-calendar/callback   (production)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# (repli côté client si GOOGLE_CLIENT_ID est absent)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
# Optionnel : force l'URI de redirection (sinon dérivée de l'origine de la requête)
# GOOGLE_REDIRECT_URI=https://<ton-domaine-vercel>/api/google-calendar/callback
